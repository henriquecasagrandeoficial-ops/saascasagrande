# --- Next.js (build e cache) ---
.next/
out/
build/
next-env.d.ts
.turbo/

# --- Variáveis de ambiente (NUNCA versionar segredos) ---
.env
.env.*
!.env.example
!.env*.example

# --- Prisma / bancos locais ---
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal

# --- Vercel ---
.vercel/

# --- TypeScript ---
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testes / cobertura ---
coverage/
*.lcov
.nyc_output/

# --- Caches ---
.cache/
.eslintcache
.stylelintcache
.npm/

# --- Certificados ---
*.pem

# --- SO: Windows ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
