# Portal unificado — Login/Hub + painéis no mesmo domínio

AUTH_SECRET="troque-por-um-segredo-aleatorio"
ADMIN_EMAIL="admin@casagrande.com"
ADMIN_PASSWORD="admin123"

# --- Banco (Vercel Postgres) ---
# Ao conectar um Postgres em Vercel → Storage, estas variáveis já vêm sozinhas:
#   POSTGRES_PRISMA_URL
#   POSTGRES_URL_NON_POOLING
# O app aceita esses nomes e também DATABASE_URL / DIRECT_URL (aliases automáticos).
#
# Ideal: 2 bancos (um por sistema). Se houver só um Storage ligado ao projeto,
# os dois painéis usam o mesmo Postgres (schemas diferentes podem conflitar).

# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."
# POSTGRES_PRISMA_URL="postgresql://..."
# POSTGRES_URL_NON_POOLING="postgresql://..."

BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
